{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "scripts/upgrade-packages/*.ts",
        "src/**/*.test.ts",
        "tests-dom/*.test.tsx"
      ]
    }
  },
  "ignore": [".codemap/**"],
  "ignoreDependencies": ["@stainless-code/codemap"],
  "ignoreBinaries": ["dedupe"],
  "ignoreWorkspaces": ["apps/*"]
}
