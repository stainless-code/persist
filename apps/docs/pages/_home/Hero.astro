---
import CodeBlock from "blume/components/content/CodeBlock.astro";
import Icon from "blume/components/Icon.astro";
import { contentHref } from "blume/components/content/base-href.ts";
import InstallBox from "./InstallBox.astro";
import { defaultSourceId, sourceSnippets } from "./source-snippets.ts";

const pillBase =
  "cursor-pointer rounded-full border px-3 py-1 text-xs transition active:scale-[0.97] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent/40";
const pillActive = "border-accent bg-accent/10 font-medium text-accent";
const pillMuted =
  "border-border text-muted-foreground hover:border-foreground/40 hover:text-foreground";
---

<section class="landing-gutter text-center">
  <div class="mx-auto max-w-[1160px]">
  <h1
    class="mx-auto max-w-3xl text-balance font-medium text-4xl tracking-tight sm:text-5xl lg:text-6xl"
  >
    <span class="block">Any store. Any storage.</span>
    <span class="block text-accent">One middleware.</span>
  </h1>

  <p class="mx-auto mt-6 max-w-2xl text-balance text-foreground text-lg">
    Stop rewriting persist glue when you swap zustand for TanStack Store — or
    localStorage for IndexedDB.
  </p>

  <p class="mx-auto mt-4 max-w-2xl text-balance text-muted-foreground">
    Zero-dep
    <code class="mx-0.5 rounded bg-muted px-1.5 font-mono text-sm"
      >persistSource</code
    >
    core; codecs, backends, transport, and framework gates are opt-in subpaths.
  </p>

  <div class="mx-auto mt-8 flex items-center justify-center gap-10">
    <div>
      <div class="font-bold text-3xl text-foreground">3</div>
      <div class="text-muted-foreground text-xs">seams</div>
    </div>
    <div>
      <div class="font-bold text-3xl text-foreground">zero-dep</div>
      <div class="text-muted-foreground text-xs">core</div>
    </div>
    <div>
      <div class="font-bold text-3xl text-foreground">opt-in</div>
      <div class="text-muted-foreground text-xs">peers</div>
    </div>
  </div>

  <div
    class="mx-auto mt-8 flex max-w-3xl flex-wrap items-center justify-center gap-2"
    data-source-pills
  >
    {
      sourceSnippets.map((snippet) => (
        <button
          class={`inline-flex items-center gap-1.5 ${pillBase} ${snippet.id === defaultSourceId ? pillActive : pillMuted}`}
          data-install-command={snippet.installCommand}
          data-source={snippet.id}
          type="button"
        >
          <Icon
            class="size-4 shrink-0 object-contain"
            name={snippet.icon}
            size={16}
          />
          {snippet.label}
        </button>
      ))
    }
  </div>

  <div class="mx-auto mt-6 max-w-2xl text-left">
    {
      sourceSnippets.map((snippet) => (
        <div
          class={snippet.id === defaultSourceId ? undefined : "hidden"}
          data-code={snippet.id}
        >
          <CodeBlock code={snippet.code} lang={snippet.lang} />
        </div>
      ))
    }
  </div>

  <div class="mt-9"><InstallBox /></div>

  <div class="mt-7 flex items-center justify-center gap-6 text-sm">
    <a
      class="inline-flex items-center gap-1 rounded-blume bg-accent px-5 py-2.5 font-medium text-accent-foreground text-sm transition-opacity hover:opacity-90"
      href={contentHref("/guides/getting-started")}
    >
      Get started
      <svg
        class="size-3.5"
        fill="none"
        height="14"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="14"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </a>
    <a
      class="inline-flex items-center gap-1 font-medium text-muted-foreground transition-colors hover:text-foreground"
      href="https://github.com/stainless-code/persist"
      rel="noreferrer"
      target="_blank"
    >
      View the code
      <svg
        class="size-3.5"
        fill="none"
        height="14"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        width="14"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path d="m9 18 6-6-6-6"></path>
      </svg>
    </a>
  </div>
  </div>
</section>

<script is:inline>
  (() => {
    // Document-delegated so the pills survive ClientRouter swaps.
    if (document.documentElement.dataset.persistPillsBound === "true") return;
    document.documentElement.dataset.persistPillsBound = "true";

    const ACTIVE = [
      "border-accent",
      "bg-accent/10",
      "font-medium",
      "text-accent",
    ];
    const MUTED = [
      "border-border",
      "text-muted-foreground",
      "hover:border-foreground/40",
      "hover:text-foreground",
    ];

    document.addEventListener("click", (e) => {
      const target = e.target instanceof Element ? e.target : null;
      const pill = target?.closest("[data-source-pills] [data-source]");
      if (!(pill instanceof HTMLElement)) return;

      const source = pill.dataset.source;
      const installCommand = pill.dataset.installCommand;
      const scope =
        pill.closest("[data-source-pills]")?.parentElement ?? document;

      scope
        .querySelectorAll("[data-source-pills] [data-source]")
        .forEach((p) => {
          if (!(p instanceof HTMLElement)) return;
          const isActive = p.dataset.source === source;
          p.classList.remove(...ACTIVE, ...MUTED);
          p.classList.add(...(isActive ? ACTIVE : MUTED));
        });

      scope.querySelectorAll("[data-code]").forEach((block) => {
        if (!(block instanceof HTMLElement)) return;
        block.classList.toggle("hidden", block.dataset.code !== source);
      });

      document.querySelectorAll("[data-blume-install-box]").forEach((box) => {
        if (!(box instanceof HTMLElement)) return;
        box.querySelectorAll("[data-install-cmd]").forEach((block) => {
          if (!(block instanceof HTMLElement)) return;
          block.classList.toggle("hidden", block.dataset.installCmd !== source);
        });
        const copyBtn = box.querySelector("[data-blume-copy-install]");
        if (copyBtn instanceof HTMLElement && installCommand) {
          copyBtn.dataset.command = installCommand;
        }
      });
    });
  })();
</script>

<script is:inline>
  (() => {
    // This shell has no copy pipeline; own per-block button, re-run after swaps.
    if (document.documentElement.dataset.persistHeroCopyBound === "true") return;
    document.documentElement.dataset.persistHeroCopyBound = "true";
    const COPY =
      '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>';
    const CHECK =
      '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-600 dark:text-green-500"><path d="M20 6 9 17l-5-5"/></svg>';
    const ensureButtons = () => {
      const scope = document.querySelector("[data-source-pills]")
        ?.parentElement;
      if (!scope) return;
      scope.querySelectorAll("[data-code] pre").forEach((pre) => {
        if (!(pre instanceof HTMLElement)) return;
        if (pre.parentElement?.closest("pre")) return;
        if (pre.querySelector("[data-persist-copy]")) return;
        pre.classList.add("group", "relative");
        const button = document.createElement("button");
        button.type = "button";
        button.className =
          "absolute top-2 right-3 z-[2] inline-flex size-[1.875rem] select-none items-center justify-center rounded-md bg-background text-muted-foreground transition-colors hover:bg-muted hover:text-foreground [&_svg]:pointer-events-none [&_svg]:shrink-0";
        button.setAttribute("data-persist-copy", "");
        button.setAttribute("aria-label", "Copy code");
        button.innerHTML = COPY;
        button.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(
              pre.querySelector("code")?.textContent ?? "",
            );
          } catch {
            return;
          }
          button.innerHTML = CHECK;
          setTimeout(() => {
            button.innerHTML = COPY;
          }, 1500);
        });
        pre.appendChild(button);
      });
    };
    ensureButtons();
    document.addEventListener("astro:after-swap", ensureButtons);
  })();
</script>
